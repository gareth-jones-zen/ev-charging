<Project Sdk="Microsoft.NET.Sdk">
  <!-- Local parity checks against the Python version, published with Native AOT so the checks run the code as the
       exes do. Never run by CI against anything live. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ev-charging-parity</AssemblyName>
    <RootNamespace>EvCharging.Parity</RootNamespace>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\EvCharging\EvCharging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
